# Copy to .env and fill in real values. Never commit .env.
ENV=local
DEBUG=0

DB_URL=postgresql+asyncpg://postgres:password@localhost:5432/ss_project
REDIS_URL=redis://localhost:6379
EMBEDDING_SERVICE_URL=http://localhost:8001/embeddings

# Login attempts per IP (default 5/5minutes). Local dev only: 1000/minute
# LOGIN_RATE_LIMIT=5/5minutes

# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=

# Frontend URL used in password reset / invitation emails
FRONTEND_URL=http://localhost:3000

# Website live chat (defaults shown). WIDGET_APP_URL empty = FRONTEND_URL.
# WIDGET_APP_URL=
# WIDGET_VISITOR_TOKEN_TTL_DAYS=30
# WIDGET_SESSION_RATE_LIMIT=5/minute
# WIDGET_MESSAGE_RATE_LIMIT=20/minute

# SMTP (leave SMTP_HOST empty in local dev: emails are printed in the log)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@shreechat.local

# AI agent: platform LLM (used when an agent has no tenant key)
# AI_PROVIDER=openai | gemini | anthropic
AI_PROVIDER=openai
AI_API_KEY=
AI_CHAT_MODEL=gpt-4o-mini
AI_CLASSIFIER_MODEL=
# Encrypts tenant AI keys. Required outside local/test.
AI_CREDENTIALS_KEY=
# Limits and behaviour (defaults shown)
# AI_RUN_TOKEN_BUDGET=20000
# AI_MAX_CONCURRENT_RUNS_PER_ORG=5
# AI_DEBOUNCE_SECONDS=2.5
# LangSmith tracing: off by default (traces contain customer content)
# AI_TRACING=false

# Prometheus metrics at GET /metrics; set a token in production
# METRICS_ENABLED=true
# METRICS_TOKEN=
